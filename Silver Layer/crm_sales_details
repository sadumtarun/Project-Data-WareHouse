
--- Table - crm_sales_details

IF OBJECT_ID ('silver.crm_sales_details', 'U') IS NOT NULL
	DROP TABLE silver.crm_sales_details;
CREATE TABLE silver.crm_sales_details (
    sd_ord_num       NVARCHAR(50),
    sd_product_key   NVARCHAR(50),
    sd_customer_id   INT,
    sd_order_dt  DATE,
    sd_ship_dt   DATE,
    sd_due_dt    DATE,
    sd_sales     INT,
    sd_quantity  INT,
    sd_price     INT
);

INSERT INTO silver.crm_sales_details (
	sd_ord_num,
	sd_product_key,
	sd_customer_id,
	sd_order_dt,
	sd_ship_dt,
	sd_due_dt,
	sd_sales,
	sd_quantity,
	sd_price
)
SELECT
sd_ord_num,
sd_product_key,
sd_customer_id,
	CASE
		WHEN sd_order_dt = 0 OR  LEN(sd_order_dt) != 8 THEN NULL
		ELSE CAST(CAST(sd_order_dt AS VARCHAR) AS DATE)
	END AS sd_order_dt,

	CASE
		WHEN sd_ship_dt = 0 OR  LEN(sd_ship_dt) != 8 THEN NULL
		ELSE CAST(CAST(sd_ship_dt AS VARCHAR) AS DATE)
	END AS sd_ship_dt,

	CASE
		WHEN sd_due_dt = 0 OR  LEN(sd_due_dt) != 8 THEN NULL
		ELSE CAST(CAST(sd_due_dt AS VARCHAR) AS DATE)
	END AS sd_due_dt,

	CASE
		WHEN sd_sales IS NULL 
		OR sd_sales <= 0
		OR sd_sales != sd_quantity * ABS(sd_price)
		THEN sd_quantity * ABS(sd_price)
		ELSE sd_sales
	END AS sd_sales,
sd_quantity,
	CASE
		WHEN sd_price IS NULL
		OR sd_price <= 0
		THEN sd_sales / NULLIF(sd_quantity, 0)
    ELSE sd_price
	END AS sd_price

FROM bronze.crm_sales_details;
