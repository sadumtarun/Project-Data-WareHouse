
--- Table - crm_product_info

IF OBJECT_ID ('silver.crm_product_info', 'U') IS NOT NULL
	DROP TABLE silver.crm_product_info;
CREATE TABLE silver.crm_product_info (
    product_id       NVARCHAR(50),
    category_id      NVARCHAR(50),
    product_key      NVARCHAR(50),
    product_nm       NVARCHAR(50),
    product_cost     NVARCHAR(50),
    product_line     NVARCHAR(50),
    product_start_dt  DATE,
    product_end_dt    DATE
);

INSERT INTO silver.crm_product_info (
	product_id,
	category_id,  
	product_key,
    product_nm,
    product_cost,     
	product_line,     
    product_start_dt,  
    product_end_dt
)
SELECT
product_id,
REPLACE(SUBSTRING(product_key, 1, 5), '-', '_') AS category_id,
SUBSTRING(product_key, 7, LEN(product_key)) AS product_key,
product_nm,
ISNULL(product_cost, 0) AS product_cost,
	CASE UPPER(TRIM(product_line))
		WHEN 'M' THEN 'Mountain'
		WHEN 'R' THEN 'Road'
		WHEN 'S' THEN 'Other Sales'
		WHEN 'T' THEN 'Touring'
	ELSE 'NA'
END AS product_line,
CAST(product_start_dt AS DATE) AS product_start_dt,
CAST(LEAD(product_start_dt) OVER(PARTITION BY product_key ORDER BY product_start_dt)-1 AS DATE) product_end_dt
FROM bronze.crm_product_info; 

