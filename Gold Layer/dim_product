
--- Table - gold.dim_product

CREATE OR ALTER VIEW gold.dim_product AS
SELECT
	ROW_NUMBER() OVER(ORDER BY pd.product_start_dt, pd.product_key) AS product_key,  -- Primary Key
	pd.product_id,
	pd.product_key		AS product_number,
	pd.product_nm		AS product_name,
	pd.category_id,
	cat.category,
	cat.subcategory,
	cat.maintenance,
	pd.product_cost,
	pd.product_line,
	pd.product_start_dt
FROM silver.crm_product_info pd
LEFT JOIN silver.erp_category cat
	ON pd.category_id = cat.id
	WHERE product_end_dt IS NULL
