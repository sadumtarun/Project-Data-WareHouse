
--- Table - gold.dim_customers

CREATE OR ALTER VIEW gold.dim_customers AS
SELECT
    CAST(ROW_NUMBER() OVER (ORDER BY customer_id) AS INT) AS customer_keys,
	cc.customer_id,
	cc.customer_key							   AS customer_numbers,
	cc.customer_firstname					 AS firstname,	
	cc.customer_lastname					 AS lastname,
	CASE
		WHEN cc.customer_gender != 'NA' THEN cc.customer_gender
		ELSE COALESCE(ec.gender, 'NA')
	END AS gender,
	eco.country,
	cc.customer_marital_status,
	ec.birthdate,
	cc.customer_create_date AS create_date
	FROM silver.crm_customer_info cc
		LEFT JOIN silver.erp_customer ec
	ON cc.customer_key = ec.cid
		LEFT JOIN silver.erp_cntry eco
	ON cc.customer_key = eco.cid
