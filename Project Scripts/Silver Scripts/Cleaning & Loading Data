CREATE OR ALTER PROCEDURE silver.load_silver AS
BEGIN
	DECLARE @start_time DATETIME,
			@end_time DATETIME,
			@batch_start_time DATETIME,
			@batch_end_time DATETIME;
	BEGIN TRY
		SET @batch_start_time = GETDATE();
		PRINT '------------------- Loading Silver Layer -------------------';

		PRINT '-------------------- Loading CRM Tables --------------------';
-- T1
		SET @start_time = GETDATE();

		PRINT '--- Truncating Table - T1 - silver.crm_customer_info';
		TRUNCATE TABLE silver.crm_customer_info;

		PRINT '--- Insert Table - T1 - silver.crm_customer_info';
		INSERT INTO silver.crm_customer_info (
			customer_id,
			customer_key,
			customer_firstname,
			customer_lastname,
			customer_marital_status,
			customer_gender,
			customer_create_date
		)
		SELECT
			customer_id,
			customer_key,
			TRIM(customer_firstname),
			TRIM(customer_lastname),
			CASE
				WHEN UPPER(TRIM(customer_marital_status)) = 'S' THEN 'Single'
				WHEN UPPER(TRIM(customer_marital_status)) = 'M' THEN 'Married'
				ELSE 'NA'
			END AS customer_marital_status,
			CASE
				WHEN UPPER(TRIM(customer_gender)) = 'F' THEN 'Female'
				WHEN UPPER(TRIM(customer_gender)) = 'M' THEN 'Male'
				ELSE 'NA'
			END AS customer_gender,
			customer_create_date
		FROM (
			SELECT
				customer_id,
				customer_key,
				customer_firstname,
				customer_lastname,
				customer_marital_status,
				customer_gender,
				customer_create_date,
				ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY customer_create_date)
				AS true_record
			FROM bronze.crm_customer_info
			WHERE customer_id IS NOT NULL
		) tr
		WHERE true_record = 1;

		SET @end_time = GETDATE();
		PRINT 'Loading Duration - ' + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR) + ' Seconds..';
		PRINT('---------------------------------');

-- T2
		SET @start_time = GETDATE();

		PRINT '--- Truncating Table - T2 - silver.crm_product_info';
		TRUNCATE TABLE silver.crm_product_info;

		PRINT '--- Insert Table - T2 - silver.crm_product_info';
		INSERT INTO silver.crm_product_info (
			product_id,
			category_id,  
			product_key,
			product_nm,
			product_cost,      
			product_line,      
			product_start_dt,  
			product_end_dt
		)
		SELECT
		product_id,
		REPLACE(SUBSTRING(product_key, 1, 5), '-', '_') AS category_id,
		SUBSTRING(product_key, 7, LEN(product_key)) AS product_key,
		product_nm,
		ISNULL(product_cost, 0) AS product_cost,
			CASE UPPER(TRIM(product_line))
				WHEN 'M' THEN 'Mountain'
				WHEN 'R' THEN 'Road'
				WHEN 'S' THEN 'Other Sales'
				WHEN 'T' THEN 'Touring'
			ELSE 'NULL'
		END AS product_line,
		CAST(product_start_dt AS DATE) AS product_start_dt,
		CAST(LEAD(product_start_dt) OVER(PARTITION BY product_key ORDER BY product_start_dt)-1 AS DATE) product_end_dt
		FROM bronze.crm_product_info;

		SET @end_time = GETDATE();
		PRINT 'Loading Duration - ' + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR) + ' Seconds..';
		PRINT('---------------------------------');

-- T3
		SET @start_time = GETDATE();

		PRINT '--- Truncating Table - T3 - silver.crm_sales_details;';
		TRUNCATE TABLE silver.crm_sales_details;

		PRINT '--- Insert Table - T3 - silver.crm_sales_details';
		INSERT INTO silver.crm_sales_details (
			sd_ord_num,
			sd_product_key,
			sd_customer_id,
			sd_order_dt,
			sd_ship_dt,
			sd_due_dt,
			sd_sales,
			sd_quantity,
			sd_price
		)
		SELECT
		sd_ord_num,
		sd_product_key,
		sd_customer_id,
			CASE
				WHEN sd_order_dt = 0 OR  LEN(sd_order_dt) != 8 THEN NULL
				ELSE CAST(CAST(sd_order_dt AS VARCHAR) AS DATE)
			END AS sd_order_dt,

			CASE
				WHEN sd_ship_dt = 0 OR  LEN(sd_ship_dt) != 8 THEN NULL
				ELSE CAST(CAST(sd_ship_dt AS VARCHAR) AS DATE)
			END AS sd_ship_dt,

			CASE
				WHEN sd_due_dt = 0 OR  LEN(sd_due_dt) != 8 THEN NULL
				ELSE CAST(CAST(sd_due_dt AS VARCHAR) AS DATE)
			END AS sd_due_dt,

			CASE
				WHEN sd_sales IS NULL 
				OR sd_sales <= 0
				OR sd_sales != sd_quantity * ABS(sd_price)
				THEN sd_quantity * ABS(sd_price)
				ELSE sd_sales
			END AS sd_sales,
		sd_quantity,
			CASE
				WHEN sd_price IS NULL
				OR sd_price <= 0
				THEN sd_sales / NULLIF(sd_quantity, 0)
			ELSE sd_price
			END AS sd_price
		FROM bronze.crm_sales_details;

		SET @end_time = GETDATE();
		PRINT 'Loading Duration - ' + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR) + ' Seconds..';
		PRINT('---------------------------------');

--T4

		PRINT '-------------------- Loading ERP Tables --------------------';

		SET @start_time = GETDATE();

		PRINT '--- Truncating Table - T4 - silver.erp_customer';
		TRUNCATE TABLE silver.erp_customer;

		PRINT '--- Insert Table - T4 - silver.erp_customer';
		INSERT INTO silver.erp_customer(cid, birthdate, gender)
		SELECT
			CASE
				WHEN cid LIKE 'NAS%'
				THEN SUBSTRING(cid, 4, LEN(cid))
			ELSE cid
		END AS cid,

			CASE
				WHEN birthdate > GETDATE() THEN NULL
			ELSE birthdate
		END AS birthdate,

			CASE
				WHEN UPPER(TRIM(gender)) IN ('F', 'FEMALE') THEN 'Female'
				WHEN UPPER(TRIM(gender)) IN ('M', 'MALE') THEN 'Male'
			ELSE NULL
		END AS gender
		FROM bronze.erp_customer;

		SET @end_time = GETDATE();
		PRINT 'Loading Duration - ' + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR) + ' Seconds..';
		PRINT('---------------------------------');

--T5
		SET @start_time = GETDATE();

		PRINT '--- Truncating Table - T5 - silver.erp_cntry';
		TRUNCATE TABLE silver.erp_cntry;

		PRINT '--- Insert Table - T5 - silver.erp_cntry';
		INSERT INTO silver.erp_cntry(cid, country)
		SELECT 
		REPLACE(cid, '-', '') AS cid,
			CASE
				WHEN UPPER(TRIM(country)) = 'DE' THEN 'Germany'
				WHEN UPPER(TRIM(country)) IN ('US', 'USA') THEN 'United States'
				WHEN UPPER(TRIM(country)) = '' OR country IS NULL THEN 'NULL'
			ELSE country
		END AS country
		FROM bronze.erp_cntry;

		SET @end_time = GETDATE();
		PRINT 'Loading Duration - ' + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR) + ' Seconds..';
		PRINT('---------------------------------');

--T6
		SET @start_time = GETDATE();

		PRINT '--- Truncating Table - T6 - silver.erp_category';
		TRUNCATE TABLE silver.erp_category;

		PRINT '--- Insert Table - T6 - silver.erp_category';
		INSERT INTO silver.erp_category(
		id,
		category,
		subcategory,
		maintenance
		)
		SELECT id, category, subcategory, maintenance
		FROM bronze.erp_category;

		SET @end_time = GETDATE();
		PRINT 'Loading Duration - ' + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR) + ' Seconds..';
		PRINT('---------------------------------');

		SET @batch_end_time = GETDATE();

		PRINT '=========================================';
		PRINT 'Loading Silver Layer Completed';
		PRINT 'Total Duration - ' + CAST(DATEDIFF(SECOND, @batch_start_time, @batch_end_time) AS NVARCHAR) + ' Seconds..';
		PRINT '=========================================';
	END TRY

	BEGIN CATCH
		PRINT '=========================================';
		PRINT 'ERROR OCCURRED DURING LOADING';
		PRINT 'Error Message: ' + ERROR_MESSAGE();
		PRINT '=========================================';
	END CATCH
END;

EXEC silver.load_silver

