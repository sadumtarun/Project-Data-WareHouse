------------------------------------- Creating Tables -------------------------------------

IF OBJECT_ID ('silver.crm_customer_info', 'U') IS NOT NULL
	DROP TABLE silver.crm_customer_info;
CREATE TABLE silver.crm_customer_info (
    customer_id				  INT,
    customer_key			  NVARCHAR(50),
    customer_firstname		  NVARCHAR(50),
    customer_lastname		  NVARCHAR(50),
    customer_marital_status   NVARCHAR(50),
    customer_gender			  NVARCHAR(50),
    customer_create_date	  DATE
);

IF OBJECT_ID ('silver.crm_product_info', 'U') IS NOT NULL
	DROP TABLE silver.crm_product_info;
CREATE TABLE silver.crm_product_info (
    product_id        INT,
    product_key       NVARCHAR(50),
    product_nm        NVARCHAR(50),
    product_cost      INT,
    product_line      NVARCHAR(50),
    product_start_dt  DATETIME,
    product_end_dt    DATETIME
);

IF OBJECT_ID ('silver.crm_sales_details', 'U') IS NOT NULL
	DROP TABLE silver.crm_sales_details;
CREATE TABLE silver.crm_sales_details (
    sd_ord_num       NVARCHAR(50),
    sd_product_key   NVARCHAR(50),
    sd_customer_id   INT,
    sd_order_dt  INT,
    sd_ship_dt   INT,
    sd_due_dt    INT,
    sd_sales     INT,
    sd_quantity  INT,
    sd_price     INT
);

----------------------------------------------------------------------------------------------

IF OBJECT_ID ('silver.erp_customer', 'U') IS NOT NULL
	DROP TABLE silver.erp_customer;
CREATE TABLE silver.erp_customer (
    cid        NVARCHAR(50),
    birthdate  DATE,
    gender     NVARCHAR(50)
);

IF OBJECT_ID ('silver.erp_cntry', 'U') IS NOT NULL
	DROP TABLE silver.erp_cntry;
CREATE TABLE silver.erp_cntry (
    cid      NVARCHAR(50),
    country  NVARCHAR(50)
);

IF OBJECT_ID ('silver.erp_category', 'U') IS NOT NULL
	DROP TABLE silver.erp_category;
CREATE TABLE silver.erp_category (
    id                NVARCHAR(50),
    category          NVARCHAR(50),
    subcategory       NVARCHAR(50),
    maintenance       NVARCHAR(50)
);

